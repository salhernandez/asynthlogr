#!/usr/bin/env bash
# Deterministic stub for the `basic-memory` CLI, used only in tests.
# asynthlogr only ever runs `basic-memory mcp` (a stdio MCP server) —
# every other subcommand fails here on purpose, so any regression to
# driving basic-memory through its CLI breaks the tests.
#
# The server logic lives in mcp-stub-respond, next to this file; state is
# in BM_STUB_STATE_DIR. BM_STUB_FAIL_LIST=1 simulates a broken install
# (the server exits without answering).
set -euo pipefail

: "${BM_STUB_STATE_DIR:?BM_STUB_STATE_DIR must be set}"
RESPOND="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/mcp-stub-respond"

case "${1:-}" in
  mcp)
    if [ "${BM_STUB_FAIL_LIST:-0}" = "1" ]; then
      echo "stub basic-memory: simulated failure" >&2
      exit 1
    fi
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s' "$line" | "$RESPOND"
    done
    ;;
  *)
    echo "stub basic-memory: '$*' — asynthlogr must use the MCP server, not the CLI" >&2
    exit 1
    ;;
esac
